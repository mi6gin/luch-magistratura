{
    "name": "rayventory/inventory-forecasting",
    "type": "project",
    "description": "Rayventory inventory forecasting system",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "symfony/process": "^7.0",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
